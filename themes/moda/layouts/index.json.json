{{- $pages := where site.RegularPages "Kind" "page" -}}
[
{{- range $i, $p := $pages -}}
  {{- if $i }},{{ end -}}
  {{- $tags := $p.Params.tags -}}
  {{- if not $tags }}{{ $tags = slice }}{{ end -}}
  {
    "title": {{ $p.Title | jsonify }},
    "section": {{ $p.Section | jsonify }},
    "permalink": {{ $p.RelPermalink | jsonify }},
    "date": {{ ($p.Date.Format "Jan 2, 2006") | jsonify }},
    "tags": {{ $tags | jsonify }},
    "content": {{ ($p.Plain | htmlUnescape) | jsonify }}
  }
{{- end -}}
]
